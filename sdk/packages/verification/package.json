{
  "name": "@atum/verification",
  "version": "0.1.0-rc.2",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": "./src/verifier.mjs",
    "./nonce-challenge": "./src/nonce-challenge.mjs",
    "./context": "./src/context.mjs",
    "./authority": "./src/authority.mjs",
    "./current-authorization": {
      "types": "./src/current-authorization.d.ts",
      "default": "./src/current-authorization.mjs"
    },
    "./resource-client": "./src/resource-client.mjs",
    "./owner-connector-client": "./src/owner-connector-client.mjs",
    "./resource-profiles": "./src/resource-profiles.mjs",
    "./service-profile": "./src/service-profile.mjs",
    "./merx-compat": "./src/merx-compat.mjs"
    ,"./clock": { "types": "./src/clock.d.ts", "default": "./src/clock.mjs" }
    ,"./node-http": { "types": "./src/node-http.d.ts", "default": "./src/node-http.mjs" }
  },
  "scripts": {
